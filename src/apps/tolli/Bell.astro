---
// Tolli sonando, la misma del icono, con su balanceo. Se queda quieta si el sistema pide menos movimiento.
interface Props { size?: number; label: string }
const { size = 260, label } = Astro.props;
---
<svg class="tolli" data-bell width={size} height={size} viewBox="-12 -4 174 154" role="img" aria-label={label}>
  <g class="waves">
    <path d="M12 64 Q4 54 12 44" fill="none" stroke="#1E1A16" stroke-width="4" stroke-linecap="round" />
    <path d="M138 64 Q146 54 138 44" fill="none" stroke="#1E1A16" stroke-width="4" stroke-linecap="round" />
  </g>
  <g class="swing">
    <circle cx="75" cy="18" r="9" fill="none" stroke="#1E1A16" stroke-width="6" />
    <path d="M75 26 C46 26 36 52 35 86 L33 100 Q24 108 22 116 L128 116 Q126 108 117 100 L115 86 C114 52 104 26 75 26 Z" fill="#E2482E" stroke="#1E1A16" stroke-width="5" stroke-linejoin="round" />
    <path d="M54 73 Q61 63 68 73" fill="none" stroke="#1E1A16" stroke-width="4.5" stroke-linecap="round" />
    <path d="M82 73 Q89 63 96 73" fill="none" stroke="#1E1A16" stroke-width="4.5" stroke-linecap="round" />
    <path d="M60 84 Q75 104 90 84 Z" fill="#1E1A16" />
    <ellipse cx="50" cy="86" rx="6" ry="3.5" fill="#F7A08E" /><ellipse cx="100" cy="86" rx="6" ry="3.5" fill="#F7A08E" />
    <circle class="clapper" cx="75" cy="124" r="9" fill="#1E1A16" />
  </g>
</svg>
<style>
  .tolli { max-width: 100%; height: auto; }
  .swing { transform-box: view-box; transform-origin: 75px 12px; animation: swing 2.6s ease-in-out infinite; }
  :global(.ringing) .swing, :global(.ringing) .clapper { animation-duration: 0.7s; }
  .clapper { transform-box: view-box; transform-origin: 75px 100px; animation: swing 2.6s ease-in-out infinite reverse; }
  .waves { animation: waves 2.6s ease-out infinite; }
  @keyframes swing { 0%, 60%, 100% { transform: rotate(0); } 10% { transform: rotate(-12deg); } 25% { transform: rotate(10deg); } 40% { transform: rotate(-5deg); } }
  @keyframes waves { 0%, 45%, 100% { opacity: 0; } 10%, 30% { opacity: 1; } }
</style>
