---
// Las caras de Tolli, las mismas de la app (guía de expresiones: ojos con blanco grande y boca en U).
interface Props { mood: 'awake' | 'soon' | 'paused' | 'sleeping' | 'worried' | 'happy'; size?: number }
const { mood, size = 96 } = Astro.props;
const night = mood === 'sleeping';
const outline = night ? '#FFF8E6' : '#1E1A16';
const fill = night ? '#F4C230' : '#E2482E';
const ink = '#1E1A16';
---
<svg width={size} height={size} viewBox="0 0 150 150" aria-hidden="true">
  <circle cx="75" cy="18" r="9" fill="none" stroke={outline} stroke-width="5" />
  <path d="M75 26 C46 26 36 52 35 86 L33 100 Q24 108 22 116 L128 116 Q126 108 117 100 L115 86 C114 52 104 26 75 26 Z" fill={fill} stroke={outline} stroke-width="4" stroke-linejoin="round" />
  {mood === 'awake' && <><circle cx="61" cy="72" r="11" fill="#FFFFFF" /><circle cx="89" cy="72" r="11" fill="#FFFFFF" /><circle cx="61" cy="72" r="4.5" fill={ink} /><circle cx="89" cy="72" r="4.5" fill={ink} /><path d="M72 76.5 L79 76.5 Q79.5 86.5 75.85 86.5 Q71.2 85.7 72 76.5 Z" fill={ink} /></>}
  {mood === 'soon' && <><circle cx="61" cy="72" r="11" fill="#FFFFFF" /><circle cx="89" cy="72" r="11" fill="#FFFFFF" /><circle cx="61" cy="69" r="6" fill={ink} /><circle cx="89" cy="69" r="6" fill={ink} /><ellipse cx="75.5" cy="80.5" rx="3" ry="4" fill={ink} /></>}
  {mood === 'paused' && <><path d="M54 72 L68 72 M82 72 L96 72" stroke={ink} stroke-width="5" stroke-linecap="round" /><path d="M72 80.5 L79 79.5" stroke={ink} stroke-width="4" stroke-linecap="round" /><path d="M116 20 h7 v22 h-7 Z M128 20 h7 v22 h-7 Z" fill={ink} /></>}
  {mood === 'sleeping' && <><path d="M54 72 Q61 78 68 72 M82 72 Q89 78 96 72" fill="none" stroke={ink} stroke-width="4.5" stroke-linecap="round" /><circle cx="75.5" cy="80.5" r="3" fill={ink} /><path d="M116 30 h12 l-12 12 h12" fill="none" stroke="#FFF8E6" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" /></>}
  {mood === 'worried' && <><path d="M51 56 L65 52 M99 56 L85 52" stroke={ink} stroke-width="4" stroke-linecap="round" /><circle cx="61" cy="72" r="11" fill="#FFFFFF" /><circle cx="89" cy="72" r="11" fill="#FFFFFF" /><circle cx="61" cy="74" r="6" fill={ink} /><circle cx="89" cy="74" r="6" fill={ink} /><path d="M71.5 84.5 Q75.5 78.5 80 83.5" fill="none" stroke={ink} stroke-width="3.5" stroke-linecap="round" /><path d="M112 50 Q106 60 112 64 Q118 60 112 50 Z" fill="#9CC9E8" stroke={ink} stroke-width="2.5" /></>}
  {mood === 'happy' && <><path d="M57 73 Q63.5 63 70 73 M80 73 Q86.5 63 93 73" fill="none" stroke={ink} stroke-width="3" stroke-linecap="round" /><path d="M70.5 75.5 L80.5 75.5 Q81 88.5 76 88.5 Q69.7 87.7 70.5 75.5 Z" fill={ink} /><ellipse cx="50" cy="86" rx="6" ry="3.5" fill="#F7A08E" /><ellipse cx="100" cy="86" rx="6" ry="3.5" fill="#F7A08E" /></>}
  <circle cx="75" cy="124" r="9" fill={outline} />
</svg>
