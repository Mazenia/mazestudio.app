---
// La pagina de Tolli Estudio. Habla Tolli en primera persona, igual que la app,
// y deja probar una pausa: la tarjeta de abajo pregunta como la notificacion.
import Base from '../../layouts/Base.astro';
import AppPosts from '../../components/AppPosts.astro';
import Face from '../tolli/Face.astro';
import { appPath, statusLabel, type App, type Lang } from '../../data/apps';

interface Props { app: App; lang: Lang }
const { app, lang } = Astro.props;
const es = lang === 'es';
const other: Lang = es ? 'en' : 'es';

const c = es ? {
  title: 'Tolli Estudio: flashcards con repetición espaciada',
  description: 'Flashcards con repetición espaciada y temporizador pomodoro para Android. Haz tarjetas con tus apuntes, a mano o con tu IA, y repásalas en las pausas.',
  face: 'Tolli, una campanita coral con cara sonriente.',
  h1: 'Hola, soy Tolli.',
  lead: 'Junto flashcards, repetición espaciada y un temporizador pomodoro. Tú haces las tarjetas con tus apuntes o con tu IA, y yo te traigo cada una justo antes de que la olvides: en las pausas de estudio o cuando me abras para repasar.',
  test: 'Pedir entrar a la prueba',
  testSubject: 'Quiero probar Tolli Estudio',
  demoTitle: 'Así llega una pregunta',
  demoHint: 'Pruébala: responde de memoria y después mira la respuesta.',
  pause: 'Pausa · pregunta',
  of: 'de',
  show: 'Ver respuesta',
  grades: [['No', '1 min'], ['Costó', '6 min'], ['Sí', '1 día'], ['Fácil', '4 días']],
  cards: [
    ['¿Qué parte de la neurona recibe las señales?', 'Las dendritas.'],
    ['¿Qué protege la médula espinal?', 'La columna vertebral.'],
    ['¿Qué acelera los impulsos nerviosos?', 'La mielina.'],
  ],
  done: 'Listo. Vuelve el enfoque y la pregunta que quede sin responder se va sola.',
  again: 'Otra vez',
  stepsTitle: 'Arma las tarjetas con tu IA',
  steps: [
    ['Te doy unas instrucciones', 'Las mando a la IA que ya usas, o las copio para que las pegues donde quieras.'],
    ['Le pasas tu material', 'Tus apuntes, una foto del pizarrón, un PDF o el enlace de una clase.'],
    ['Pegas la respuesta', 'Armo las tarjetas por tema. Las revisas, corriges o quitas antes de agregarlas.'],
  ],
  stepsNote: 'La IA hace el trabajo mecánico; recordar sigue siendo cosa tuya. También puedes pegar tu propia lista de preguntas o escribir las tarjetas a mano.',
  featuresTitle: 'Repetición espaciada con las tarjetas que haces',
  features: [
    ['Vuelven cuando estás por olvidarlas', 'Cada tarjeta vuelve en el momento justo, según FSRS, un algoritmo de repetición espaciada de código abierto.'],
    ['Te digo qué toca hoy', 'Cuántas tarjetas y de qué temas, y si son las que te cuestan. Puedes repasar en la app sin esperar la pausa.'],
    ['Si te atrasas, no pasa nada', 'Van primero las que llevan más tiempo esperando. No hace falta ponerse al día en un solo día.'],
    ['Cada materia con su color', 'Con sus temas. Buscas en todas, mueves tarjetas, ordenas la lista y archivas la materia cuando termina el curso.'],
    ['Con fecha de examen', 'Reparto las tarjetas nuevas para que las hayas visto todas una semana antes. La última semana es solo de repaso.'],
    ['Todo en tu teléfono', 'Sin cuenta y sin servidor. Tus tarjetas quedan en el teléfono y en la copia de Android, o en tu Drive si activas la sincronización, y exportas una copia cuando quieras.'],
  ],
  facesTitle: 'Mi cara te cuenta cómo vas',
  faces: [['awake', 'Enfoque'], ['soon', 'Ya casi es la pausa'], ['happy', 'Al día'], ['worried', 'Algo me calla'], ['sleeping', 'Hasta mañana']],
  proTitle: 'Gratis. Y Pro, si quieres más.',
  proBody: 'Gratis: una materia activa con todo, todas las tarjetas que quieras, su fecha de examen y su plan, las preguntas en la pausa, agregar con tu IA, todos los planes y sonidos, y exportar tu copia. Pro, sin suscripción: materias sin límite, tarjetas con imagen para tapar partes de un diagrama, sincronizar con tu Drive, el modo AnkiDroid y tres estilos más.',
  proPrice: 'Un solo pago',
  faqTitle: 'Preguntas',
  faq: [
    ['¿Necesito una IA en particular?', 'No. Sirve la que ya usas. Y si no quieres usar ninguna, pegas tu propia lista de preguntas o escribes las tarjetas a mano.'],
    ['¿Qué pasa con mis apuntes?', 'Se los mandas tú a tu IA. Yo no tengo servidor: solo leo el texto que pegas y guardo las tarjetas en tu teléfono.'],
    ['¿Funcionas sin internet?', 'Sí, para estudiar y repasar. Solo hace falta internet para hablar con tu IA.'],
    ['¿Puedo probarte antes?', 'Sí. Busco estudiantes para la prueba en Google Play. Escribe a hola@mazestudio.app.'],
    ['¿Estás en iPhone?', 'Por ahora solo en Android. Si me quieres en iPhone, escribe a hola@mazestudio.app.'],
  ],
  privacy: 'Sin cuenta y sin anuncios. Tus tarjetas se quedan en tu teléfono.',
  privacyLink: 'Política de privacidad',
} : {
  title: 'Tolli Study: spaced repetition flashcards for Android',
  description: 'Flashcards with spaced repetition and a pomodoro timer for Android. Make cards from your notes, by hand or with your AI, and review them in your breaks.',
  face: 'Tolli, a little coral bell with a smiling face.',
  h1: "Hi, I'm Tolli.",
  lead: "I mix flashcards, spaced repetition and a pomodoro timer. You make the cards from your notes or with your AI, and I bring each one back right before you'd forget it: in your study breaks, or any time you open me to review.",
  test: 'Ask to join the test',
  testSubject: 'I want to try Tolli Study',
  demoTitle: 'This is how a question arrives',
  demoHint: 'Try it: answer in your head first, then show the answer.',
  pause: 'Break · question',
  of: 'of',
  show: 'Show answer',
  grades: [['Again', '1 min'], ['Hard', '6 min'], ['Good', '1 day'], ['Easy', '4 days']],
  cards: [
    ['Which part of a neuron receives signals?', 'The dendrites.'],
    ['What protects the spinal cord?', 'The spine.'],
    ['What speeds up nerve impulses?', 'Myelin.'],
  ],
  done: 'Done. Focus starts again, and any question you skipped goes away by itself.',
  again: 'Again',
  stepsTitle: 'Make cards with your AI',
  steps: [
    ['I give you instructions', 'I send them to the AI you already use, or copy them so you can paste them anywhere.'],
    ['You give it your material', 'Your notes, a photo of the whiteboard, a PDF or a lecture link.'],
    ['You paste the reply', 'I turn it into cards grouped by topic. You check, fix or remove them before adding.'],
  ],
  stepsNote: 'The AI does the busywork; remembering is still up to you. You can also paste your own list of questions or write cards by hand.',
  featuresTitle: 'Spaced repetition with the cards you make',
  features: [
    ['Cards come back just before you forget', 'Each card returns at the right moment, scheduled by FSRS, an open-source spaced repetition algorithm.'],
    ["I tell you what's due today", "How many cards and from which topics, and whether they're the ones you find hard. You can review in the app without waiting for a break."],
    ["Falling behind is fine", "The ones that have waited longest come first. You don't have to catch up in one day."],
    ['Each subject has its color', 'And its topics. Search across all of them, move cards, reorder the list, and archive a subject when the course ends.'],
    ['With an exam date', "I spread out the new cards so you've seen them all a week before. The last week is review only."],
    ['Everything on your phone', 'No account, no server. Your cards stay on your phone and in your Android backup, or in your Drive if you turn on sync, and you can export a copy any time.'],
  ],
  facesTitle: 'My face tells you how it’s going',
  faces: [['awake', 'Focus'], ['soon', 'Break soon'], ['happy', 'All caught up'], ['worried', 'Something stops me'], ['sleeping', 'See you tomorrow']],
  proTitle: 'Free. And Pro, if you want more.',
  proBody: 'Free: one active subject with everything, as many cards as you want, its exam date and plan, questions in your breaks, adding with your AI, every study plan and sound, and exporting your copy. Pro, no subscription: unlimited subjects, image cards where you cover parts of a diagram, sync with your Drive, AnkiDroid mode, and three more styles.',
  proPrice: 'One payment',
  faqTitle: 'Questions',
  faq: [
    ['Do I need a particular AI?', "No. The one you already use works. And if you'd rather not use one, paste your own list of questions or write cards by hand."],
    ['What happens to my notes?', "You send them to your AI yourself. I have no server: I only read the text you paste and keep the cards on your phone."],
    ['Do you work offline?', 'Yes, for studying and reviewing. You only need the internet to talk to your AI.'],
    ['Can I try you early?', "Yes. I'm looking for students for the Google Play test. Write to hola@mazestudio.app."],
    ['Are you on iPhone?', 'Only on Android for now. If you want me on iPhone, write to hola@mazestudio.app.'],
  ],
  privacy: 'No account and no ads. Your cards stay on your phone.',
  privacyLink: 'Privacy policy',
};
const mail = `mailto:hola@mazestudio.app?subject=${encodeURIComponent(c.testSubject)}`;
const data = JSON.stringify({ cards: c.cards, pause: c.pause, of: c.of });
---
<Base title={c.title} description={c.description} lang={lang} altPath={appPath(app, other)} app={app}>

  <section class="hero">
    <div class="copy">
      <h1>{c.h1}</h1>
      <p class="lead">{c.lead}</p>
      <div class="ctas">
        {app.playUrl
          ? <a class="btn primary" href={app.playUrl}>Google Play</a>
          : <span class="btn primary is-soon">{statusLabel[app.status][lang]} · Google Play</span>}
        {/* La prueba anticipada solo tiene sentido mientras la app no esta en Google Play. */}
        {!app.playUrl && <a class="btn" href={mail}>{c.test}</a>}
      </div>
    </div>
    <div class="hero-face" role="img" aria-label={c.face}><Face mood="happy" size={260} fill="#EE7A5C" /></div>
  </section>

  <section class="demo" aria-labelledby="demo-title">
    <div class="demo-copy">
      <h2 id="demo-title" class="eyebrow">{c.demoTitle}</h2>
      <p>{c.demoHint}</p>
    </div>
    <div class="notif" data-demo={data} aria-live="polite">
      <p class="notif-head"><span class="dot" aria-hidden="true"></span><span data-head>{c.pause} 1 {c.of} 3</span></p>
      <p class="q" data-q>{c.cards[0][0]}</p>
      <p class="a" data-a hidden>{c.cards[0][1]}</p>
      <button type="button" class="reveal" data-reveal>{c.show}</button>
      <div class="grades" data-grades hidden>
        {c.grades.map(([g, t], i) => (
          <button type="button" class:list={[{ strong: i === 2 }]} data-grade><strong>{g}</strong><span>{t}</span></button>
        ))}
      </div>
      <div class="done" data-done hidden>
        <p>{c.done}</p>
        <button type="button" class="reveal" data-restart>{c.again}</button>
      </div>
    </div>
  </section>

  <section class="steps" aria-labelledby="steps-title">
    <h2 id="steps-title" class="section-title">{c.stepsTitle}</h2>
    <ol>
      {c.steps.map(([h, p], i) => <li><span class="n">{i + 1}</span><h3>{h}</h3><p>{p}</p></li>)}
    </ol>
    <p class="note">{c.stepsNote}</p>
  </section>

  <section class="features" aria-labelledby="features-title">
    <h2 id="features-title" class="section-title">{c.featuresTitle}</h2>
    <div class="grid">
      {c.features.map(([h, p]) => <article><h3>{h}</h3><p>{p}</p></article>)}
    </div>
  </section>

  <section class="faces" aria-labelledby="faces-title">
    <h2 id="faces-title" class="section-title">{c.facesTitle}</h2>
    <ul>
      {c.faces.map(([mood, label]) => (
        <li class={mood === 'sleeping' ? 'night' : ''}>
          <Face mood={mood as any} size={88} fill={mood === 'sleeping' ? undefined : '#EE7A5C'} />
          <span>{label}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="pro">
    <div>
      <h2>{c.proTitle}</h2>
      <p>{c.proBody}</p>
    </div>
    <span class="price">{c.proPrice}</span>
  </section>

  <section class="faq" aria-labelledby="faq-title">
    <h2 id="faq-title" class="section-title">{c.faqTitle}</h2>
    {c.faq.map(([q, a]) => (
      <details><summary>{q}</summary><p>{a}</p></details>
    ))}
  </section>

  <AppPosts app={app} lang={lang} />

  <section class="closing">
    <p>{c.privacy}</p>
    <a href={appPath(app, lang, 'privacy')}>{c.privacyLink}</a>
  </section>
</Base>

<script>
  // La pausa de muestra: tres preguntas, como en la notificacion. Sin guardar nada.
  const box = document.querySelector<HTMLElement>('[data-demo]')!;
  const { cards, pause, of } = JSON.parse(box.dataset.demo!) as { cards: [string, string][]; pause: string; of: string };
  const $ = (s: string) => box.querySelector<HTMLElement>(s)!;
  let i = 0;
  const show = () => {
    const done = i >= cards.length;
    $('[data-done]').hidden = !done;
    $('[data-q]').hidden = done;
    $('[data-a]').hidden = true;
    $('[data-grades]').hidden = true;
    $('[data-reveal]').hidden = done;
    if (done) return;
    $('[data-head]').textContent = `${pause} ${i + 1} ${of} ${cards.length}`;
    $('[data-q]').textContent = cards[i][0];
    $('[data-a]').textContent = cards[i][1];
  };
  $('[data-reveal]').addEventListener('click', () => {
    $('[data-a]').hidden = false;
    $('[data-grades]').hidden = false;
    $('[data-reveal]').hidden = true;
  });
  box.querySelectorAll('[data-grade]').forEach((b) => b.addEventListener('click', () => { i++; show(); }));
  $('[data-restart]').addEventListener('click', () => { i = 0; show(); });
</script>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 32px; align-items: center; padding-block: 32px 56px; }
  h1 { font-size: clamp(48px, 8vw, 92px); line-height: 0.96; font-weight: 700; }
  .lead { font-size: 21px; margin: 20px 0 28px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .btn { display: inline-flex; align-items: center; min-height: 52px; padding: 0 24px; border-radius: 999px; border: 3px solid var(--ink); background: var(--surface); font: 700 17px/1 var(--display); text-decoration: none; transition: transform 240ms cubic-bezier(.34,1.56,.64,1); }
  .btn:hover { transform: translateY(-2px); }
  .btn:active { transform: scale(.96); }
  .btn.primary { background: var(--accent); color: var(--on-accent); box-shadow: 0 5px 0 var(--ink); }
  .btn.is-soon { cursor: default; }
  .hero-face { justify-self: center; }
  .hero-face :global(svg) { max-width: 100%; height: auto; }

  .demo { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 16px; align-items: center; }
  .eyebrow { font: 600 14px/1.3 var(--body); letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
  .demo-copy p { font-size: 18px; margin: 8px 0 0; }
  .notif [hidden] { display: none; }
  .notif { background: var(--surface); border: 3px solid var(--ink); border-radius: 28px; padding: 22px; min-width: 0; border-left: 14px solid var(--accent); }
  .notif-head { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 14px; color: var(--muted); font-weight: 600; }
  .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--accent); border: 2px solid var(--ink); }
  .q { font: 600 24px/1.25 var(--display); margin: 12px 0 0; }
  .a { font: 700 26px/1.2 var(--display); color: var(--ink); background: color-mix(in srgb, var(--accent) 22%, transparent); border-radius: 12px; padding: 6px 10px; display: inline-block; margin: 12px 0 0; }
  .reveal { margin-top: 18px; min-height: 48px; padding: 0 22px; border-radius: 999px; border: 3px solid var(--ink); background: var(--accent); color: var(--on-accent); font: 700 17px/1 var(--display); cursor: pointer; box-shadow: 0 4px 0 var(--ink); }
  .reveal:active { transform: scale(.96); }
  .grades { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin-top: 18px; }
  .grades button { min-height: 64px; border-radius: 18px; border: 2.5px solid var(--ink); background: var(--bg); color: var(--ink); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; cursor: pointer; transition: transform 240ms cubic-bezier(.34,1.56,.64,1); }
  .grades button.strong { background: var(--accent); color: var(--on-accent); }
  .grades button:active { transform: scale(.94); }
  .grades strong { font: 700 17px/1 var(--display); }
  .grades span { font-size: 13px; }
  .done p { font-size: 18px; margin: 12px 0 0; }

  .section-title { font-size: clamp(30px, 4vw, 44px); margin: 72px 0 20px; }
  .steps ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
  .steps li { background: var(--surface); border: 3px solid var(--ink); border-radius: 24px; padding: 22px; min-width: 0; }
  .steps .n { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--ink); color: var(--bg); font: 700 20px/1 var(--display); }
  .steps h3 { font-size: 22px; line-height: 1.2; margin-top: 12px; }
  .steps p { margin: 8px 0 0; font-size: 16px; }
  .steps .note { font-size: 17px; margin-top: 18px; max-width: 60ch; }

  .features .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .features article { background: var(--surface); border: 3px solid var(--ink); border-radius: 24px; padding: 22px; min-width: 0; }
  .features h3 { font-size: 22px; line-height: 1.2; }
  .features p { margin: 8px 0 0; font-size: 16px; }

  .faces ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 12px; }
  .faces li { background: var(--surface); border: 3px solid var(--ink); border-radius: 22px; padding: 16px 10px; display: flex; flex-direction: column; align-items: center; gap: 8px; font-weight: 700; font-size: 15px; text-align: center; }
  .faces li.night { background: #1A2236; color: #F5F7FB; }

  section.pro { margin-top: 72px; background: var(--ink); color: var(--bg); border-radius: 28px; padding: clamp(24px, 4vw, 40px); display: flex; flex-wrap: wrap; gap: 20px 40px; align-items: center; justify-content: space-between; }
  section.pro h2 { font-size: clamp(28px, 3.6vw, 40px); }
  section.pro p { margin: 10px 0 0; font-size: 17px; max-width: 62ch; }
  .price { font: 700 24px/1 var(--display); background: var(--bg); color: var(--ink); border-radius: 999px; padding: 14px 22px; white-space: nowrap; }

  .faq details { border-bottom: 2px solid var(--ink); padding: 16px 4px; }
  .faq summary { cursor: pointer; font: 700 20px/1.3 var(--display); }
  .faq p { margin: 10px 0 0; }

  .closing { margin-top: 56px; }
  .closing p { font-size: 18px; margin-bottom: 6px; }
  .closing a { font-weight: 700; }

  @media (max-width: 760px) {
    .hero, .demo { grid-template-columns: 1fr; }
    .hero-face { order: -1; }
    .hero-face :global(svg) { width: 200px; }
    .grades { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
