---
import Base from '../layouts/Base.astro';
interface Props { lang: 'en' | 'es' }
const { lang } = Astro.props;
const es = lang === 'es';
const c = es ? {
  title: 'Maze Studio · Apps pequeñas, hechas con cuidado',
  description: 'Maze Studio hace apps para iPhone y Android que te ayudan con tu tiempo y tu atención: Dear Wander y Tolli.',
  h1: 'Apps pequeñas para cuidar tu tiempo y tu atención.',
  lead: 'Somos un estudio de una persona. Cada app hace una cosa, la hace bien y no te pide más datos de los que necesita.',
  tolli: 'Una campanita que suena cada pocos minutos para que no pierdas la noción del tiempo.',
  tolliMeta: 'Android · Pronto',
  dw: 'Una respiración de un minuto antes de abrir las apps donde más haces scroll.',
  dwMeta: 'iPhone · Android',
  more: 'Ver',
} : {
  title: 'Maze Studio · Small apps, made with care',
  description: 'Maze Studio makes iPhone and Android apps that help with your time and attention: Dear Wander and Tolli.',
  h1: 'Small apps that look after your time and attention.',
  lead: 'We are a one-person studio. Each app does one thing, does it well, and asks for no more data than it needs.',
  tolli: 'A little bell that dings every few minutes so you keep track of time.',
  tolliMeta: 'Android · Coming soon',
  dw: 'A one-minute breath before you open the apps you scroll most.',
  dwMeta: 'iPhone · Android',
  more: 'See',
};
---
<Base title={c.title} description={c.description} lang={lang} altPath={es ? '/' : '/es/'}>
  <section class="hero">
    <h1>{c.h1}</h1>
    <p>{c.lead}</p>
  </section>
  <section class="apps" aria-label="Apps">
    <a class="app tolli" href={es ? '/es/tolli/' : '/tolli/'}>
      <img src="/img/tolli-icon.png" alt="" width="88" height="88" />
      <div>
        <h2>Tolli</h2>
        <p>{c.tolli}</p>
        <span class="meta">{c.tolliMeta}</span>
      </div>
    </a>
    <a class="app dw" href="https://dearwander.com">
      <img src="/img/dear-wander-icon.png" alt="" width="88" height="88" />
      <div>
        <h2>Dear Wander</h2>
        <p>{c.dw}</p>
        <span class="meta">{c.dwMeta} · dearwander.com ↗</span>
      </div>
    </a>
  </section>
</Base>
<style>
  .hero { padding-block: 72px 56px; }
  .hero h1 { font-size: clamp(36px, 6vw, 64px); line-height: 1.04; letter-spacing: -0.03em; font-weight: 700; max-width: 16ch; }
  .hero p { font-size: 19px; color: var(--muted); margin-top: 20px; }
  .apps { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
  .app { display: flex; gap: 20px; align-items: flex-start; padding: 24px; border-radius: 24px; text-decoration: none; transition: transform 200ms cubic-bezier(.34,1.56,.64,1); min-width: 0; }
  .app:hover { transform: translateY(-3px); }
  .app img { border-radius: 22px; flex-shrink: 0; }
  .app h2 { font-size: 26px; }
  .app p { margin: 6px 0 10px; }
  .meta { font-size: 13px; font-weight: 600; opacity: 0.75; }
  .tolli { background: #F4C230; color: #1E1A16; border: 3px solid #1E1A16; }
  .tolli h2 { font-family: 'Fredoka', sans-serif; }
  .dw { background: #F7E3C4; color: #3B2A1E; }
</style>
