---
// Portada del estudio, direccion C del lienzo: titulo enorme y las apps como
// filas de un indice que se tinen del color de cada app al pasar por encima.
import Base from '../layouts/Base.astro';
import { apps, appPath, statusLabel } from '../data/apps';
interface Props { lang: 'en' | 'es' }
const { lang } = Astro.props;
const es = lang === 'es';
const c = es ? {
  title: 'Maze Studio · Apps pequeñas para tu tiempo y tu atención',
  description: 'Maze Studio hace apps para iPhone y Android que te ayudan con tu tiempo y tu atención: Dear Wander y Tolli.',
  h1: 'Apps pequeñas para tu tiempo y tu atención.',
  about: 'Maze Studio es una sola persona. Yo diseño y programo cada app.',
  aboutBody: 'Para usarlas no necesitas crear una cuenta, y no tienen anuncios. Lo que guardas se queda en tu teléfono. Si algo falla, escríbeme a',
  aboutEnd: 'y te respondo yo.',
} : {
  title: 'Maze Studio · Small apps for your time and attention',
  description: 'Maze Studio makes iPhone and Android apps that help with your time and attention: Dear Wander and Tolli.',
  h1: 'Small apps for your time and attention.',
  about: 'Maze Studio is one person. I design and build each app myself.',
  aboutBody: "You don't need an account to use them, and there are no ads. What you save stays on your phone. If something breaks, write to",
  aboutEnd: "and I'll reply myself.",
};
// Datos para que Google entienda que es un estudio con varias apps.
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Maze Studio',
  url: 'https://mazestudio.app/',
  logo: 'https://mazestudio.app/favicon.svg',
  email: 'hola@mazestudio.app',
  description: c.description,
};
---
<Base title={c.title} description={c.description} lang={lang} altPath={es ? '/' : '/es/'} ogImage={es ? '/img/og-studio-es.png' : '/img/og-studio.png'}>
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  <section class="hero"><h1>{c.h1}</h1></section>

  <section class="index" aria-label="Apps">
    {apps.map((app) => {
      const href = app.externalUrl ?? (app.status === 'building' ? undefined : appPath(app, lang));
      const Tag = href ? 'a' : 'div';
      const meta = `${app.status === 'building' ? '' : `${app.platforms} · `}${statusLabel[app.status][lang]}`;
      return (
        <Tag class:list={['row', { soon: app.status === 'building' }]} href={href}
          style={`--hover-bg:${app.hover.bg};--hover-ink:${app.hover.ink}`}>
          {app.icon ? <img src={app.icon} alt="" width="96" height="96" /> : <span class="placeholder" aria-hidden="true"></span>}
          <div class="text">
            <span class="name" style={app.nameFont ? `font-family:${app.nameFont};letter-spacing:0` : undefined}>{app.name}</span>
            <span class="line">{app.tagline[lang]}</span>
          </div>
          <span class="meta">{meta}{href && <span class="arrow" aria-hidden="true">{app.externalUrl ? '↗' : '→'}</span>}</span>
        </Tag>
      );
    })}
  </section>

  <section class="about">
    <p class="big">{c.about}</p>
    <p>{c.aboutBody} <a href="mailto:hola@mazestudio.app">hola@mazestudio.app</a> {c.aboutEnd}</p>
  </section>
</Base>
<style>
  .hero { padding-block: 56px 56px; border-bottom: 2px solid var(--ink); }
  h1 { font-size: clamp(48px, 9vw, 132px); line-height: 0.9; letter-spacing: -0.05em; font-weight: 750; max-width: none; }
  .row { display: grid; grid-template-columns: 96px minmax(0, 1fr) auto; gap: 20px 32px; align-items: center; padding: 32px 16px; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--ink); transition: background-color 200ms ease, color 200ms ease; }
  .row img, .placeholder { width: 96px; height: 96px; border-radius: 22px; }
  .placeholder { border: 2px dashed var(--line); }
  .text { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .name { font: 700 clamp(36px, 5vw, 64px)/1 var(--display); letter-spacing: -0.03em; }
  .line { font-size: 18px; color: var(--muted); }
  .meta { display: flex; flex-direction: column; align-items: flex-end; gap: 10px; font-size: 14px; font-weight: 600; white-space: nowrap; }
  .arrow { font-size: 28px; transition: transform 260ms cubic-bezier(.34,1.56,.64,1); }
  .row:hover .arrow { transform: translateX(8px); }
  a.row:hover { background: var(--hover-bg); color: var(--hover-ink); }
  .row:hover .line { color: inherit; }
  .row.soon { color: var(--muted); border-bottom: 2px solid var(--ink); }
  .about { margin-top: 88px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 32px 64px; }
  .about p { margin: 0; font-size: 17px; line-height: 1.6; color: var(--muted); }
  .about .big { font: 600 30px/1.2 var(--display); letter-spacing: -0.02em; color: var(--ink); }
  .about a { font-weight: 700; color: var(--ink); }
  @media (max-width: 640px) {
    .row { grid-template-columns: 64px minmax(0, 1fr); padding: 24px 8px; }
    .row img, .placeholder { width: 64px; height: 64px; border-radius: 16px; }
    .meta { grid-column: 2; align-items: flex-start; flex-direction: row; }
  }
</style>
