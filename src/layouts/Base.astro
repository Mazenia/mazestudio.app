---
// El marco de todas las paginas del estudio. Si la pagina es de una app, toma
// los colores y la tipografia de esa app (src/data/apps.ts), asi su pagina se
// parece a la app; la cabecera y el pie siguen siendo del estudio.
import { getCollection } from 'astro:content';
import { apps, appPath, type App, type BlogLang } from '../data/apps';
import { langTag, langName } from '../lib/blog';

interface Props {
  title: string;
  description: string;
  lang: BlogLang;
  /** La misma pagina en el otro idioma, para el selector y hreflang. */
  altPath?: string;
  /** Si la pagina existe en mas de dos idiomas: la ruta de cada uno (incluido el propio). */
  alternates?: Partial<Record<BlogLang, string>>;
  app?: App;
  ogImage?: string;
  /** 'article' en los posts del blog; el resto son 'website'. */
  ogType?: 'website' | 'article';
  /** Para paginas que no deben salir en Google (la de error 404): sin canonical ni hreflang. */
  noindex?: boolean;
}
const { title, description, lang, altPath = '/', alternates, app, ogImage = '/img/og-studio.png', ogType = 'website', noindex = false } = Astro.props;
const withSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const canonical = new URL(withSlash(Astro.url.pathname), Astro.site);
// Las versiones de esta pagina: las que pasa la pagina o, si no, ingles y espanol.
const versions: Partial<Record<BlogLang, string>> = alternates
  ? { ...alternates, [lang]: Astro.url.pathname }
  : { [lang]: Astro.url.pathname, [lang === 'en' ? 'es' : 'en']: altPath };
const hreflangs = (Object.entries(versions) as [BlogLang, string][]).map(([l, p]) => [langTag[l], new URL(withSlash(p), Astro.site)] as const);
const enUrl = versions.en ? new URL(withSlash(versions.en), Astro.site) : canonical;
const others = (Object.entries(versions) as [BlogLang, string][]).filter(([l]) => l !== lang);
const home = lang === 'es' ? '/es/' : '/';
const t = {
  en: { apps: 'Apps', privacy: 'privacy', terms: 'terms' },
  es: { apps: 'Apps', privacy: 'privacidad', terms: 'términos' },
  pt: { apps: 'Apps', privacy: 'privacidade', terms: 'termos' },
}[lang];
const th = app?.theme;
const themeStyle = th
  ? `--bg:${th.bg};--surface:${th.surface};--ink:${th.ink};--muted:${th.muted};--line:${th.ink};--accent:${th.accent};--on-accent:${th.onAccent};--display:${th.display};--body:${th.body};`
  : undefined;
const footerApps = apps.filter((a) => a.status !== 'building');
const withTerms = new Set((await getCollection('terms')).map((e) => e.id.split('.')[0]));
---
<!doctype html>
<html lang={langTag[lang]} data-app={app?.slug} style={themeStyle}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="p:domain_verify" content="d0a291c704c66467d8c73b4c2a67b0fc" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex" /> : <>
    <link rel="canonical" href={canonical} />
    {hreflangs.map(([tag, url]) => <link rel="alternate" hreflang={tag} href={url} />)}
    <link rel="alternate" hreflang="x-default" href={enUrl} />
  </>}
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Maze Studio" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, Astro.site)} />
  {!noindex && <meta property="og:url" content={canonical} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href={app?.icon || '/favicon.svg'} />
  {th && <meta name="theme-color" content={th.bg} />}
  {/* Se precarga la fuente del titulo de la pagina: la de la app o la del estudio. */}
  <link rel="preload" href={th?.display.includes('Fredoka') ? '/fonts/Fredoka.woff2' : '/fonts/BricolageGrotesque.woff2'} as="font" type="font/woff2" crossorigin />
  <style is:global>
    @font-face { font-family: 'Fredoka'; src: url('/fonts/Fredoka.woff2') format('woff2'); font-weight: 300 700; font-display: swap; }
    @font-face { font-family: 'DM Sans'; src: url('/fonts/DMSans.woff2') format('woff2'); font-weight: 100 1000; font-display: swap; }
    @font-face { font-family: 'Bricolage Grotesque'; src: url('/fonts/BricolageGrotesque.woff2') format('woff2'); font-weight: 200 800; font-display: swap; }
    @font-face { font-family: 'Schibsted Grotesk'; src: url('/fonts/SchibstedGrotesk.woff2') format('woff2'); font-weight: 400 900; font-display: swap; }

    /* Estudio (el indice): blanco, tinta casi negra y tipografia grande.
       Sin acento propio: el color lo pone cada app. */
    :root {
      --bg: #FBFBFA; --surface: #FFFFFF; --ink: #101114; --muted: #5F626A; --line: #D9DADD; --accent: #101114; --on-accent: #FBFBFA;
      --display: 'Bricolage Grotesque', system-ui, sans-serif; --body: 'Schibsted Grotesk', system-ui, sans-serif;
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-app]) { --bg: #111214; --surface: #1A1B1F; --ink: #EDEDEA; --muted: #A3A6AE; --line: #2E3036; --accent: #EDEDEA; --on-accent: #111214; color-scheme: dark; }
    }
    *, *::before, *::after { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body { margin: 0; background: var(--bg); color: var(--ink); font: 400 17px/1.6 var(--body); overflow-x: hidden; }
    a { color: inherit; }
    a:focus-visible, button:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; border-radius: 6px; }
    .wrap { max-width: 1160px; margin: 0 auto; padding-inline: max(20px, env(safe-area-inset-left, 0px)) max(20px, env(safe-area-inset-right, 0px)); }
    header.site { display: flex; align-items: baseline; justify-content: space-between; gap: 12px 24px; flex-wrap: wrap; padding-block: 28px; }
    .brand { font: 700 20px/1 'Bricolage Grotesque', system-ui, sans-serif; letter-spacing: -0.02em; text-decoration: none; }
    header.site nav { display: flex; gap: 12px 24px; flex-wrap: wrap; font-size: 15px; }
    header.site nav a { text-decoration: none; }
    .lang { color: var(--muted); }
    footer.site { margin-top: 96px; padding-block: 36px 44px; border-top: 1px solid var(--line); color: var(--muted); font-size: 14px; display: flex; flex-wrap: wrap; gap: 12px 32px; justify-content: space-between; }
    footer.site nav { display: flex; gap: 8px 20px; flex-wrap: wrap; }
    h1, h2, h3 { font-family: var(--display); text-wrap: balance; margin: 0; }
    p { max-width: 62ch; }
    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
  </style>
</head>
<body>
  <div class="wrap">
    <header class="site">
      <a class="brand" href={home}>Maze Studio</a>
      <nav>
        <a href={lang === 'en' ? '/blog/' : `/${lang}/blog/`}>Blog</a>
        <a href="mailto:hola@mazestudio.app">hola@mazestudio.app</a>
        {others.map(([l, p]) => <a class="lang" href={withSlash(p)} hreflang={langTag[l]} lang={langTag[l]}>{langName[l]}</a>)}
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site">
      <span>© 2026 Maze Studio</span>
      <nav aria-label={t.apps}>
        {footerApps.map((a) => <a href={a.externalUrl ?? appPath(a, lang)}>{a.name}</a>)}
        {footerApps.filter((a) => !a.externalUrl).map((a) => <a href={appPath(a, lang, 'privacy')}>{a.name} · {t.privacy}</a>)}
        {footerApps.filter((a) => withTerms.has(a.slug)).map((a) => <a href={appPath(a, lang, 'terms')}>{a.name} · {t.terms}</a>)}
      </nav>
    </footer>
  </div>
</body>
</html>
