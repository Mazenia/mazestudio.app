---
// El marco de todas las paginas del estudio. Si la pagina es de una app, toma
// los colores y la tipografia de esa app (src/data/apps.ts), asi su pagina se
// parece a la app; la cabecera y el pie siguen siendo del estudio.
import { apps, appPath, type App, type Lang } from '../data/apps';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** La misma pagina en el otro idioma, para el selector y hreflang. */
  altPath: string;
  app?: App;
  ogImage?: string;
}
const { title, description, lang, altPath, app, ogImage = '/img/og-studio.png' } = Astro.props;
const withSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const canonical = new URL(withSlash(Astro.url.pathname), Astro.site);
const alt = new URL(withSlash(altPath), Astro.site);
const enUrl = lang === 'en' ? canonical : alt;
const esUrl = lang === 'es' ? canonical : alt;
const home = lang === 'es' ? '/es/' : '/';
const t = {
  en: { other: 'Español', apps: 'Apps', privacy: 'privacy' },
  es: { other: 'English', apps: 'Apps', privacy: 'privacidad' },
}[lang];
const th = app?.theme;
const themeStyle = th
  ? `--bg:${th.bg};--surface:${th.surface};--ink:${th.ink};--muted:${th.muted};--line:${th.ink};--accent:${th.accent};--on-accent:${th.onAccent};--display:${th.display};--body:${th.body};`
  : undefined;
const footerApps = apps.filter((a) => a.status !== 'building');
---
<!doctype html>
<html lang={lang} data-app={app?.slug} style={themeStyle}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="es" href={esUrl} />
  <link rel="alternate" hreflang="x-default" href={enUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, Astro.site)} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href={app?.icon || '/favicon.svg'} />
  {th && <meta name="theme-color" content={th.bg} />}
  <link rel="preload" href="/fonts/BricolageGrotesque.ttf" as="font" type="font/ttf" crossorigin />
  <style is:global>
    @font-face { font-family: 'Fredoka'; src: url('/fonts/Fredoka.ttf') format('truetype'); font-weight: 300 700; font-display: swap; }
    @font-face { font-family: 'DM Sans'; src: url('/fonts/DMSans.ttf') format('truetype'); font-weight: 100 1000; font-display: swap; }
    @font-face { font-family: 'Bricolage Grotesque'; src: url('/fonts/BricolageGrotesque.ttf') format('truetype'); font-weight: 200 800; font-display: swap; }
    @font-face { font-family: 'Schibsted Grotesk'; src: url('/fonts/SchibstedGrotesk.ttf') format('truetype'); font-weight: 400 900; font-display: swap; }

    /* Estudio (el indice): blanco, tinta casi negra y tipografia grande.
       Sin acento propio: el color lo pone cada app. */
    :root {
      --bg: #FBFBFA; --surface: #FFFFFF; --ink: #101114; --muted: #5F626A; --line: #D9DADD; --accent: #101114; --on-accent: #FBFBFA;
      --display: 'Bricolage Grotesque', system-ui, sans-serif; --body: 'Schibsted Grotesk', system-ui, sans-serif;
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-app]) { --bg: #111214; --surface: #1A1B1F; --ink: #EDEDEA; --muted: #A3A6AE; --line: #2E3036; --accent: #EDEDEA; --on-accent: #111214; color-scheme: dark; }
    }
    *, *::before, *::after { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body { margin: 0; background: var(--bg); color: var(--ink); font: 400 17px/1.6 var(--body); overflow-x: hidden; }
    a { color: inherit; }
    a:focus-visible, button:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; border-radius: 6px; }
    .wrap { max-width: 1160px; margin: 0 auto; padding-inline: max(20px, env(safe-area-inset-left, 0px)) max(20px, env(safe-area-inset-right, 0px)); }
    header.site { display: flex; align-items: baseline; justify-content: space-between; gap: 12px 24px; flex-wrap: wrap; padding-block: 28px; }
    .brand { font: 700 20px/1 'Bricolage Grotesque', system-ui, sans-serif; letter-spacing: -0.02em; text-decoration: none; }
    header.site nav { display: flex; gap: 12px 24px; flex-wrap: wrap; font-size: 15px; }
    header.site nav a { text-decoration: none; }
    .lang { color: var(--muted); }
    footer.site { margin-top: 96px; padding-block: 36px 44px; border-top: 1px solid var(--line); color: var(--muted); font-size: 14px; display: flex; flex-wrap: wrap; gap: 12px 32px; justify-content: space-between; }
    footer.site nav { display: flex; gap: 8px 20px; flex-wrap: wrap; }
    h1, h2, h3 { font-family: var(--display); text-wrap: balance; margin: 0; }
    p { max-width: 62ch; }
    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
  </style>
</head>
<body>
  <div class="wrap">
    <header class="site">
      <a class="brand" href={home}>Maze Studio</a>
      <nav>
        <a href="mailto:hola@mazestudio.app">hola@mazestudio.app</a>
        <a class="lang" href={withSlash(altPath)} hreflang={lang === 'en' ? 'es' : 'en'}>{t.other}</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site">
      <span>© 2026 Maze Studio</span>
      <nav aria-label={t.apps}>
        {footerApps.map((a) => <a href={a.externalUrl ?? appPath(a, lang)}>{a.name}</a>)}
        {footerApps.filter((a) => !a.externalUrl).map((a) => <a href={appPath(a, lang, 'privacy')}>{a.name} · {t.privacy}</a>)}
      </nav>
    </footer>
  </div>
</body>
</html>
